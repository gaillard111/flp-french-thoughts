<div class="panel panel-info">
    <div class="panel-heading">
        <h2 class="panel-title">{{ 'navbar.registration'|trans({}, 'messages') }}</h2>
    </div>
    <div class="panel-body">
        <form action="{{ path('fos_user_registration_register') }}" {{ form_enctype(form) }} method="POST" id="registerForm" class="fos_user_registration_register form-horizontal">

            {{ form_start(form) }}
            {{ form_row(form.email) }}
            {{ form_row(form.firstname) }}
            {{ form_row(form.lastname) }}
            {{ form_row(form.plainPassword) }}
            {{ form_label(form.roles) }}
            <div class="role-select">
                <div class="role-item">
                    {{ form_widget(form.roles[0]) }} <label for="front_user_registration_form_roles_0" class="label-role">{{ form.roles[0].vars['label'] }}</label>
                </div>
                <div class="role-item">
                    {{ form_widget(form.roles[1]) }} <label for="front_user_registration_form_roles_1" class="label-role">{{ form.roles[1].vars['label'] }}</label>
                </div>
                <div class="role-item">
                    {{ form_widget(form.roles[2]) }} <label for="front_user_registration_form_roles_1" class="label-role">{{ form.roles[2].vars['label'] }}</label>
                </div>
            </div>

            <div class="form-actions col-sm-7">
                <input
                        type="submit"
                        value="{{ 'user.form.registration.button'|trans({}, 'messages') }}"
                        class="btn btn-info pull-right"
{#                        id="captcha"#}
                />
            </div>
            {{ form_end(form) }}
        </form>
    </div>
</div>

<script src='https://www.google.com/recaptcha/api.js?render=6Lf0gnIUAAAAAIOcDJST9QKJdz7KhbvcacgvizF5'></script>