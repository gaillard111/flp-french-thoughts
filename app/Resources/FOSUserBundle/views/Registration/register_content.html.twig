{% trans_default_domain 'FOSUserBundle' %}
{% form_theme form '@ApplicationSonataUser/Form/registration_form.html.twig' %}

<div class="panel panel-info">
    <div class="panel-heading">
        <h2 class="panel-title">{{ 'navbar.registration'|trans({}, 'messages') }}</h2>
    </div>
    <div class="panel-body">
        {{ form_start(form, {'attr': {'class': 'form-horizontal'}}) }}

            <ul class="form-error"><li>{{ form_errors(form.email) }}</li></ul>
            <div class="form-group">
                {{ form_label(form.email) }}
                <div class="col-sm-7">
                    {{ form_widget(form.email) }}
                </div>
            </div>

            <ul class="form-error"><li>{{ form_errors(form.firstname) }}</li></ul>
            <div class="form-group">
                {{ form_label(form.firstname) }}
                <div class="col-sm-7">
                    {{ form_widget(form.firstname) }}
                </div>
            </div>

            <ul class="form-error"><li>{{ form_errors(form.lastname) }}</li></ul>
            <div class="form-group">
                {{ form_label(form.lastname) }}
                <div class="col-sm-7">
                    {{ form_widget(form.lastname) }}
                </div>
            </div>

            <ul class="form-error"><li>{{ form_errors(form.plainPassword.children.first) }}</li></ul>
            <div class="form-group">
                {{ form_label(form.plainPassword.children.first) }}
                {{ form_errors(form.plainPassword) }}
                <div class="col-sm-7">
                    {{ form_widget(form.plainPassword.children.first) }}
                </div>
            </div>

            <ul class="form-error"><li>{{ form_errors(form.plainPassword.children.second) }}</li></ul>
            <div class="form-group">
                {{ form_label(form.plainPassword.children.second) }}
                <div class="col-sm-7">
                    {{ form_widget(form.plainPassword.children.second) }}
                </div>
            </div>

            <div class="form-group">
                {{ form_label(form.roles) }}
                <div class="col-sm-10">
                    <div class="role-select">
                        <div class="role-item">
                            <label class="label-role">
                                {{ form_widget(form.roles[0]) }}
                                {{ form.roles[0].vars['label'] }}
                            </label>
                        </div>
                        <div class="role-item">
                            <label class="label-role">
                                {{ form_widget(form.roles[1]) }} {{ form.roles[1].vars['label'] }}
                            </label>
                        </div>
                        <div class="role-item">
                            <label class="label-role">
                                {{ form_widget(form.roles[2]) }} {{ form.roles[2].vars['label'] }}
                            </label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <div class="col-sm-offset-2 col-sm-10">
                    <div class="checkbox">
                        <ul class="form-error"><li>{{ form_errors(form.termsOfService) }}</li></ul>
                        <label>
                            {{ form_widget(form.termsOfService) }} {{ form.termsOfService.vars['label'] }}
                        </label>
                    </div>
                </div>
                <div class="col-sm-offset-2 col-sm-10">
                    <div class="checkbox">
                        <label>
                            {{ form_widget(form.receiveEmails) }} {{ form.receiveEmails.vars['label'] }}
                        </label>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <div class="col-sm-offset-2 col-sm-10">
                    <button type="submit" class="btn btn-info">{{ 'user.form.registration.button'|trans({}, 'messages') }}</button>
                </div>
            </div>
        {{ form_end(form) }}
    </div>
</div>

<script>
    $(document).ready(function () {
        let $form = $('form[name="fos_user_registration_form"]');
        $form.submit(function(event) {
            let $tosCheckbox = $form.find('input[name="fos_user_registration_form[termsOfService]"]')
            if (!$tosCheckbox.is(":checked")) {
                event.preventDefault();
                alert('Svp acceptez les mentions légales pour continuer')
            }
        })
    });
