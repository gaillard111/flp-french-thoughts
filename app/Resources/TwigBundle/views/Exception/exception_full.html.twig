{% extends status_code == '404' ? '@Thought/layout.html.twig' : '@Twig/layout.html.twig' %}


{% block head %}
    <link href="{{ absolute_url(asset('bundles/framework/css/exception.css')) }}" rel="stylesheet" type="text/css" media="all" />
{% endblock %}

{% block title %}
    {{ exception.message }} ({{ status_code }} {{ status_text }})
{% endblock %}

{% block body %}
    {% include '@Twig/Exception/exception.html.twig' %}
{% endblock %}

{% block content %}
    <div class="error404">
        <div class="title">404</div>
        <div class="href">
            <p>La page que vous recherchiez n'existe pas</p>
            <p><a href=”{{ path('thought_homepage_index') }}”>Aller à la page d'accueil</a></p>
        </div>
    </div>
{% endblock %}
