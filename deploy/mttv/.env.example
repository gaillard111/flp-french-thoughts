# ──────────────────────────────────────────────────────────────────────────────
# MTTV-FLP — Variables d'environnement pour le déploiement Hidora VPS
# =============================================================================
# Copier ce fichier vers ../.env (à la racine du projet) et remplir les valeurs.
# Ce fichier est lu automatiquement par docker-compose et entrypoint.sh.
#
# SENSIBLE : Ne JAMAIS committer le fichier .env contenant les vraies valeurs.
#            Ajouter .env à .gitignore.
#
# Signature SCS_2026 · sig:0x4D545456
# ──────────────────────────────────────────────────────────────────────────────

# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  TOKENS & AUTHENTIFICATION                                             ║
# ╚══════════════════════════════════════════════════════════════════════════╝

# Token GitHub avec permissions repo (création de branches de test)
# https://github.com/settings/tokens
# MTTV_GITHUB_TOKEN=ghp_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Token Hugging Face (optionnel, pour injection dataset)
# MTTV_HF_TOKEN=hf_XXXXXXXXXXXXXXXXXXXXXXXXXX

# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  CONFIGURATION IPFS                                                    ║
# ╚══════════════════════════════════════════════════════════════════════════╝

# API HTTP du nœud IPFS (interne au réseau Docker)
MTTV_IPFS_API=http://ipfs:5001

# Gateway HTTP IPFS
MTTV_IPFS_GATEWAY=http://ipfs:8080

# Profil IPFS (server par défaut, ou lowpower pour restriction max)
MTTV_IPFS_PROFILE=lowpower

# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  RÉSEAU & API GATEWAY                                                  ║
# ╚══════════════════════════════════════════════════════════════════════════╝

# Port d'écoute de l'API Gateway FastAPI (interne)
MTTV_API_PORT=8000

# Hôte d'écoute
MTTV_API_HOST=0.0.0.0

# Origines CORS autorisées (séparées par des virgules)
# Laisser vide pour désactiver CORS
MTTV_CORS_ORIGINS=

# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  WATCHDOG & ORCHESTRATEUR                                              ║
# ╚══════════════════════════════════════════════════════════════════════════╝

# Intervalle entre les cycles de vérification du watchdog (secondes)
# 60s = mode réactif, 300s = mode sobre recommandé
MTTV_WATCHDOG_INTERVAL=300

# Mode sobre : true = réduit la fréquence des opérations coûteuses
MTTV_SOBER_MODE=true

# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  ALERTES (Webhook + SMTP)                                              ║
# ╚══════════════════════════════════════════════════════════════════════════╝

# Canal primaire : URL de webhook (Discord, Slack, Teams, etc.)
# ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Canal secondaire SMTP (fallback Gmail — pré-configuré)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=girard444@gmail.com
SMTP_PASS=csjx nyyu ezdl wueu

# Destinataire des alertes (par défaut : identique à l'expéditeur)
# ALERT_RECIPIENT=girard444@gmail.com

# Destinataire des alertes (par défaut : identique à l'expéditeur)
# ALERT_RECIPIENT=girard444@gmail.com

# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  BASE DE DONNÉES MySQL (Hidora locale — optionnel)                     ║
# ╚══════════════════════════════════════════════════════════════════════════╝

# Connexion à la base MySQL existante sur le VPS Hidora.
# Utiliser 127.0.0.1 si MySQL tourne sur l'hôte (pas dans Docker).
# Pour un accès depuis un conteneur Docker, utiliser host.docker.internal
# ou l'IP du pont Docker (172.17.0.1).
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=flp
MYSQL_PASSWORD=NBui4!fnD32
MYSQL_DATABASE=mttv_flp

# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  GARDE-FOU RESSOURCES (resource_guardrail.py)                          ║
# ╚══════════════════════════════════════════════════════════════════════════╝

# Seuil quotidien de trafic réseau sortant (MB)
# Au-delà de cette valeur, une alerte est déclenchée.
MAX_DAILY_TRAFFIC_MB=500

# Seuil mémoire RAM (MB)
# Au-delà de cette valeur, une alerte est déclenchée.
MAX_RAM_MB=180

# Délai de temporisation entre deux alertes consécutives (secondes)
# Évite les notifications répétitives en cas de dépassement continu.
ALERT_COOLDOWN_SEC=3600

# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  MODE DÉPLOIEMENT                                                      ║
# ╚══════════════════════════════════════════════════════════════════════════╝

# Mode de déploiement : hidora, local, production
MTTV_DEPLOY_MODE=hidora

# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  MÉTRIQUES & LOGS                                                      ║
# ╚══════════════════════════════════════════════════════════════════════════╝

# Niveau de log (DEBUG, INFO, WARNING, ERROR)
MTTV_LOG_LEVEL=INFO

# Taille maximale des fichiers de log (bytes) avant rotation
MTTV_LOG_MAX_BYTES=10485760

# Nombre de fichiers de log archivés
MTTV_LOG_BACKUP_COUNT=3
