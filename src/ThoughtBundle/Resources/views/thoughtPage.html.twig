{% extends 'ThoughtBundle::layout.html.twig' %}

{% block page_title %}Les fils de la pensée{% endblock %}

{% block content %}

    {% if not app.user %}
        {{ include('@Thought/include/likeModal.html.twig') }}
    {% endif %}

    {{ include('@Thought/quoteLayout.html.twig', {'thought': thought}) }}

    <div class="row block_comments">
        <div class="col-sm-12">
            <h3>{{ 'thought.comment.title'|trans }}</h3>
        </div>
        <div class="col-sm-12">
            {% for comment in thought.comments %}
                <div class="panel panel-info comment-item col-sm-12">
                    <div class="panel-heading row">
                        <div class="col-sm-6">
                            {#<a href="{{ path('user_profile', { 'userId': comment.user.id }) }}">#}
                                {{ comment.fullName }}
                            {#</a>#}
                            {#{{ dump(comment) }}#}
                        </div>
                        <div class="col-sm-6 text-right">
                            {% if is_granted('ROLE_ADMIN') %}
                                <a href="{{ path('thought_thoughtpage_deletecomment', {'commentId': comment.id}) }}">{{ 'user.comment.delete'|trans }}</a>
                            {% endif %}
                            {{ comment.createdAt|date('Y-m-d H:i') }}
                        </div>
                    </div>
                    <div class="panel-body">{{ comment.text|nl2br }}</div>
                </div>
            {% else %}
                {{ 'thought.comment.no_comments'|trans }}
            {% endfor %}
        </div>
    </div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('bundles/thought/js/quote_functions.js') }}"></script>
    <script>
        $(".related-thoughts-label").click(function () {
            var $this = $(this);
            var $relatedThoughts = $this.next();

            if ($relatedThoughts.is(":hidden")) {
                $relatedThoughts.css('display', 'flex');
            } else {
                $relatedThoughts.hide();
            }

        });
    </script>
{% endblock %}