{% extends 'ThoughtBundle::layout.html.twig' %}

{% block page_title %}French thoughts{% endblock %}

{% block content %}
    {% include '@Thought/search_thought.html.twig' %}

    <div class="row">
        <div class="col-sm-6">{{ 'thought.filter.result_counter'|trans }}: {{ thoughts.getTotalItemCount() }}</div>
        <div class="col-sm-6 text-right">{{ 'thought.filter.time_counter'|trans }}: {{ timeExecute|round(4) }}s</div>
    </div>


    <div class="navigation text-center">
        {{ knp_pagination_render(thoughts) }}
    </div>

    {% for thought in thoughts %}
        <div class="jumbotron">
            <p>
                <strong class="col-sm-2">{{ 'thought.property.author'|trans|capitalize }}</strong>
                <span>
                    <a class="underline" href="{{ path('thought_homepage_index', {'search[words]': thought.author, 'search[field][author]': 'on'}) }}">{{ thought.author }}</a>
                </span>
            </p>
            <p>
                <strong class="col-sm-2">{{ 'thought.property.category'|trans|capitalize }}</strong>
                <span>
                    <a class="underline" href="{{ path('thought_homepage_index', {'search[words]': thought.category, 'search[field][category]': 'on'}) }}">{{ thought.category }}</a>
                </span>
            </p>
            <p>
                <strong class="col-sm-12">{{ 'thought.property.content'|trans|capitalize }}</strong>
                <span><em>{{ thought.content|raw }}</em></span>
            </p>
            <p>
                <strong class="col-sm-2">{{ 'thought.property.thoughtInfo'|trans|capitalize }}</strong>
                <span>{{ thought.thoughtInfo|raw }}</span>
            </p>
            <p>
                <strong class="col-sm-2">{{ 'thought.property.tags'|trans|capitalize }}</strong>
                <span>
                    {% for tag in thought.tags|split(',') %}
                        <a href="{{ path('thought_homepage_index', {'search[words]': tag, 'search[field][tags]': 'on'}) }}">
                            <span class="label label-info">{{ tag }}</span>
                        </a>
                    {% endfor %}
                </span>
            </p>
            <p>
                {% set liked = (thought.id in app.request.cookies.get('quotes')|split(',')) ? true : false %}
                <button class="btn btn-info btn-sm like-quote" data-quote="{{ thought.id }}" type="button">
                    <span class="badge-text">
                        {{ liked ? 'thought.property.liked'|trans : 'thought.property.like'|trans }}
                    </span> <span class="badge" style="display: {{ (thought.liked > 0) ? 'inline-block' : 'none' }}">{{ thought.liked }}</span>
                </button>
            </p>
        </div>
    {% else %}

    {% endfor %}

    <div class="navigation text-center">
        {{ knp_pagination_render(thoughts) }}
    </div>

{% endblock %}