{% extends 'ThoughtBundle::layout.html.twig' %}

{% block page_title %}Les fils de la pensée{% endblock %}

{% block content %}
    {% set search = app.request.get('search') %}
    {% set is_fields = search.field is defined ? true : false %}
    {% if not app.request.cookies.get('modal') %}
        {% block popup %}
            {{ include('@Thought/include/tutorialModal.html.twig') }}
        {% endblock %}
    {% endif %}



    {% if thoughts.paginationData.totalCount == 0 %}
        <div class="row not-found-text">
            <div class="col-sm-12">
                There were no thoughts found by your request.
                Please <a href="{{ path('sonata_user_thought_create') }}">suggest</a> your own quote.
            </div>
        </div>
    {% endif %}
    <div class="row">
        <div class="col-sm-offset-6 banner-container">
            {% for banner in banners %}
                {{ render(controller('ThoughtBundle:Homepage:banner', { 'banner': banner })) }}
            {% endfor %}
        </div>
    </div>
    <form method="get" xmlns="http://www.w3.org/1999/html">
        <div class="row">
            {#<div class="col-sm-12">#}
                <div class="form-group mainsearch">
                    <label for="inputSearch">{{ 'thought.filter.content.label'|trans }}</label>
                    <input value="{{ search.words is defined ? search.words : '' }}" type="text" name="search[words]" class="form-control" id="inputSearch" placeholder="{{ 'thought.filter.content.placeholder'|trans }}">
                </div>
                <div class="form-group">
                    <button class="btn btn-info">{{ 'thought.filter.buttons.search'|trans }}</button>
                    <a href="/" class="btn btn-warning">{{ 'thought.filter.buttons.reset'|trans }}</a>
                    <a href="{{ path('thought_homepage_index', {'search[words]': '', 'search[field][content]': 'on', 'search[field][category]': 'on', 'search[field][tags]': 'on', 'search[field][author]': 'on', 'search[field][thoughtInfo]': 'on', 'search[sorting]': 'liked', 'search[sorting_desc]':'true'}) }}" class="btn btn-warning">{{ 'thought.filter.buttons.last_quotes'|trans }}</a>
                </div>
            {#</div>#}

        </div>

        <div class="row">
            <div class="col-md-2">
                {% include '@Thought/search_thought.html.twig' %}
            </div>
            <div class="col-md-8">

                <div class="row">
                    <div class="col-sm-12 margin-bottom-17" style="clear: both;">{{ welcomeText ? welcomeText.content|shortText(350, path('content', {'code' : 'welcome'}))|raw : '' }}</div>
                </div>

                {% if cloud|length > 0  %}
                    <div class="row">
                        <div class="form-group col-sm-12">
                            <a id="cloud_button" style="cursor: pointer; border-bottom: 1px dashed #337ab7; text-decoration: none;">{{ 'thought.filter.cloud_tags'|trans }} </a>
                        </div>
                    </div>
                    <div id="cloud_block" class="col-sm-12 margin-bottom-17" style="display: none;">
                        {% for word, size in cloud %}
                            <a href="{{ path('thought_homepage_index', {'search[words]': word, 'search[field][content]': 'on', 'search[field][category]': 'on', 'search[field][tags]': 'on', 'search[field][author]': 'on', 'search[field][thoughtInfo]': 'on'}) }}" style='color: #000; display: inline-block; margin-right: 10px; font-size: {{ cloudStyle[word]['font-size'] }}px ; font-weight: {{ cloudStyle[word]['font-weight'] }} ;'>
                                {{ word }}
                            </a>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="row">
                        <div class="form-group col-sm-12">
                            <span style="border-bottom: 1px dashed #000;">{{ 'thought.filter.cloud_tags'|trans }}</span> : {{ 'thought.filter.activate_cloud'|trans }}
                        </div>
                    </div>
                {% endif %}

                <div class="row">
                    <div class="col-sm-6">{{ 'thought.filter.result_counter'|trans }}: {{ thoughts.getTotalItemCount() }}</div>
                    <div class="col-sm-6 text-right">{{ 'thought.filter.time_counter'|trans }}: {{ timeExecute|round(4) }}s</div>
                </div>

                <div class="navigation text-center hidden-xs">
                    {{ knp_pagination_render(thoughts) }}
                </div>


                {% for thought in thoughts %}
                    {{ include('@Thought/quoteLayout.html.twig', {'thought': thought, 'colChains': colChains }) }}
                {% endfor %}

                <div class="navigation text-center">
                    {{ knp_pagination_render(thoughts) }}
                </div>

            </div>
            <div class="col-md-2 hidden-xs hidden-sm">
                {% if is_granted('ROLE_USER') %}
                    {{ render(controller('ApplicationSonataUserBundle:Thought:menu', { 'routeName': app.request.get('_route') })) }}
                {% endif %}
            </div>
        </div>

    </form>

{% endblock %}

{% block javascripts %}
    <script>
        // $('span[data-toggle="tooltip"]').tooltip({
        //     animated: 'fade',
        //     placement: 'bottom',
        //     trigger: 'click'
        // });

        var HasTooltip = $('.hastooltip');
        HasTooltip.on('click', function(e) {
            e.preventDefault();
            var isShowing = $(this).data('isShowing');
            HasTooltip.removeData('isShowing');
            if (isShowing !== 'true')
            {
                HasTooltip.not(this).tooltip('hide');
                $(this).data('isShowing', "true");
                $(this).tooltip('show');
            }
            else
            {
                $(this).tooltip('hide');
            }

        }).tooltip({
            animation: true,
            trigger: 'manual'
        });

        function buttonToggle(source, target, show_val, hide_val, input) {

            if (target.offsetWidth === 0 && target.offsetHeight === 0) {
                target.style.display = 'block';
            } else {
                target.style.display = 'none';
            }
        }

        document.getElementById('advanced_search_button').onclick = (function() {
            var table = document.getElementById('advanced_search_block');
            return function() {
                buttonToggle(this, table, 'View', 'Hide');
            };
        }());

        document.getElementById('1_search_button').onclick = (function() {
            var table = document.getElementById('1_search_block');
            return function() {
                buttonToggle(this, table, 'View', 'Hide');
            };
        }());

        document.getElementById('2_search_button').onclick = (function() {
            var table = document.getElementById('2_search_block');
            return function() {
                buttonToggle(this, table, 'View', 'Hide');
            };
        }());

        document.getElementById('3_search_button').onclick = (function() {
            var table = document.getElementById('3_search_block');
            return function() {
                buttonToggle(this, table, 'View', 'Hide');
            };
        }());

        if (document.getElementById('filters_button')) {
            document.getElementById('filters_button').onclick = (function() {
                var table = document.getElementById('filters_block');
                var filterOpen = document.getElementById('filter_block_open');

                return function() {
                    filterOpen.getAttribute('value') == '1' ? filterOpen.setAttribute('value', '0') : filterOpen.setAttribute('value', '1');
                    buttonToggle(this, table, 'View', 'Hide', filterOpen);
                };
            }());
        }

        if (document.getElementById('cloud_button')) {
            document.getElementById('cloud_button').onclick = (function() {
                var table = document.getElementById('cloud_block');
                return function() {
                    buttonToggle(this, table, 'View', 'Hide');
                };
            }());
        }

    </script>

    <script>
        $(document).ready(function() {

            $(this).scroll(function () {
                var $menu = $('.fixed-menu');

                if ($(window).scrollTop() >= 300) {
                    $menu.css('position', 'fixed');
                    $menu.css('top', '20px');
                }
                if ($(window).scrollTop() <= 300) {
                    $menu.css('position', '');
                    $menu.css('top', '');
                }
            });

            $('#myModal').modal('show');

            $('span.author a').mouseover(function(){
                $(this).parents('div.quote').find('div.authors_info').fadeIn();
            }).mouseout(function(){
                $(this).parents('div.quote').find('div.authors_info').fadeOut();
            });

            $('.show-link').click(function () {
                var $btn = $(this);
                var thoughtId = $btn.data('id');
                var $element = $('.comments[data-id=' + thoughtId + ']');
                if ($element.hasClass('hidden')) {
                    $element.removeClass('hidden');
                } else {
                    $element.addClass('hidden');
                }
            });

        });

    </script>
{% endblock %}