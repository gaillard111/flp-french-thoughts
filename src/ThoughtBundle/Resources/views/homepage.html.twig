{% extends 'ThoughtBundle::layout.html.twig' %}

{% block page_title %}Les fils de la pensée{% endblock %}

{% block content %}
    <div class="row">
        <div class="col-sm-12 margin-bottom-17">{{ welcomeText ? welcomeText.content|raw : '' }}</div>
    </div>

    {% include '@Thought/search_thought.html.twig' %}

    <div class="row">
        <div class="col-sm-6">{{ 'thought.filter.result_counter'|trans }}: {{ thoughts.getTotalItemCount() }}</div>
        <div class="col-sm-6 text-right">{{ 'thought.filter.time_counter'|trans }}: {{ timeExecute|round(4) }}s</div>
    </div>


    <div class="navigation text-center">
        {{ knp_pagination_render(thoughts) }}
    </div>

    {% for thought in thoughts %}
        <div class="jumbotron">
            <p class="quote_title">
                <span>
                    <a href="{{ path('thought_homepage_index', {'search[words]': thought.category, 'search[field][category]': 'on', 'search[strict]': 'on'}) }}">{{ thought.category }}</a>
                </span>
                {% if is_granted('ROLE_ADMIN') %}
                    <span class="quote_edit">
                        <a href="{{ path('admin_thought_thought_edit', {'id': thought.id}) }}">
                            {{ 'user.thought.list_page.link.edit'|trans }}
                        </a>
                    </span>
                {% endif %}
            </p>
            <p class="quote_content">
                <span><em>{{ thought.content|customTag|raw|nl2br }}</em></span>
            </p>
            <p>
                <strong>{{ 'thought.property.author'|trans|capitalize }}:</strong>
                <span>
                    <a href="{{ path('thought_homepage_index', {'search[words]': thought.author, 'search[field][author]': 'on', 'search[strict]': 'on'}) }}">{{ thought.author }}</a>
                </span>
            </p>
            <p>
                <strong>{{ 'thought.property.thoughtInfo'|trans|capitalize }}:</strong>
                <span>{{ thought.thoughtInfo|raw }}</span>
            </p>
            <p class="quote_tags">
                <span>
                    {% for tag in thought.tags|split(' , ') %}
                        {% if tag|trim|length > 0 %}
                            [<a href="{{ path('thought_homepage_index', {'search[words]': tag, 'search[field][tags]': 'on'}) }}">
                                <span>{{ tag }}</span>
                            </a>]
                        {% endif %}
                    {% endfor %}
                </span>
            </p>
            <p>
                {% set liked = (thought.id in app.request.cookies.get('quotes')|split(',')) ? true : false %}
                <button class="btn btn-info btn-sm like-quote" data-quote="{{ thought.id }}" type="button">
                    <span class="badge-text">
                        {{ liked ? 'thought.property.liked'|trans : 'thought.property.like'|trans }}
                    </span> <span class="badge" style="display: {{ (thought.liked > 0) ? 'inline-block' : 'none' }}">{{ thought.liked }}</span>
                </button>
            </p>
        </div>
    {% else %}

    {% endfor %}

    <div class="navigation text-center">
        {{ knp_pagination_render(thoughts) }}
    </div>

{% endblock %}