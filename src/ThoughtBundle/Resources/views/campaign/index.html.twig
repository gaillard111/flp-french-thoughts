{# sig:0x4D545456 — MTTV-FLP Core 2026 · Campagne de Diffusion Mycélienne · ∇·Ψ #}
{% extends 'ThoughtBundle::layout.html.twig' %}

{% block page_title %}Campagne de Diffusion Mycélienne — Graines MTTV-FLP{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .campaign-hero {
            background: #f5f0eb;
            border-left: 4px solid #6b5b4f;
            padding: 2em 1.5em;
            margin-bottom: 2em;
        }
        .campaign-hero h1 {
            margin-top: 0;
            font-size: 1.6em;
            color: #3a2a1e;
        }
        .campaign-hero .sig {
            font-family: monospace;
            color: #9e8a7a;
            font-size: 0.85em;
        }
        .campaign-principles {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 1em;
            margin: 1.5em 0;
        }
        .principle-card {
            background: #fff;
            border: 1px solid #e0d6cc;
            border-radius: 4px;
            padding: 1em;
        }
        .principle-card h3 {
            margin-top: 0;
            font-size: 1em;
            color: #5a4a3e;
            border-bottom: 1px solid #e0d6cc;
            padding-bottom: 0.4em;
        }
        .principle-card p {
            margin: 0.5em 0 0;
            font-size: 0.92em;
            color: #6b5b4f;
            line-height: 1.5;
        }
        .seed-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 1.2em;
            margin: 1.5em 0;
        }
        .seed-card {
            background: #fff;
            border: 1px solid #d4c8bc;
            border-radius: 6px;
            padding: 1.2em;
            transition: box-shadow 0.2s;
        }
        .seed-card:hover {
            box-shadow: 0 2px 8px rgba(107, 91, 79, 0.15);
        }
        .seed-card .seed-id {
            font-family: monospace;
            font-size: 0.85em;
            color: #9e8a7a;
        }
        .seed-card h3 {
            margin: 0.3em 0 0.6em;
            font-size: 1.1em;
            color: #3a2a1e;
        }
        .seed-card .seed-text {
            font-style: italic;
            color: #5a4a3e;
            line-height: 1.6;
            margin-bottom: 0.8em;
        }
        .seed-card .seed-meta {
            font-size: 0.85em;
            color: #9e8a7a;
            border-top: 1px solid #e8e0d6;
            padding-top: 0.6em;
        }
        .seed-card .seed-operator {
            display: inline-block;
            background: #6b5b4f;
            color: #fff;
            padding: 0.15em 0.5em;
            border-radius: 3px;
            font-size: 0.85em;
            margin-right: 0.4em;
        }
        .target-section {
            margin: 2em 0;
        }
        .target-table {
            width: 100%;
            border-collapse: collapse;
            margin: 1em 0;
        }
        .target-table th {
            text-align: left;
            background: #f0eae4;
            padding: 0.6em 1em;
            border-bottom: 2px solid #d4c8bc;
            color: #3a2a1e;
            font-size: 0.92em;
        }
        .target-table td {
            padding: 0.6em 1em;
            border-bottom: 1px solid #e0d6cc;
            font-size: 0.9em;
            color: #5a4a3e;
        }
        .target-table tr:hover td {
            background: #faf6f2;
        }
        .mode-list {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 1em;
            margin: 1.5em 0;
        }
        .mode-card {
            background: #faf6f2;
            border: 1px solid #e0d6cc;
            border-radius: 4px;
            padding: 1em;
        }
        .mode-card h4 {
            margin: 0 0 0.4em;
            color: #3a2a1e;
            font-size: 1em;
        }
        .mode-card p {
            margin: 0.3em 0;
            font-size: 0.88em;
            color: #6b5b4f;
            line-height: 1.5;
        }
        .mode-card .ethique {
            font-style: italic;
            color: #8a7a6a;
        }
        .signal-list {
            list-style: none;
            padding: 0;
        }
        .signal-list li {
            padding: 0.8em 1em;
            border-bottom: 1px solid #e0d6cc;
            line-height: 1.5;
        }
        .signal-list li:last-child {
            border-bottom: none;
        }
        .signal-list strong {
            color: #3a2a1e;
        }
        .signal-list .t4 {
            font-family: monospace;
            color: #9e8a7a;
            font-size: 0.85em;
        }
        .guardrails {
            background: #faf6f2;
            border: 1px solid #d4c8bc;
            border-radius: 6px;
            padding: 1.2em;
            margin: 1.5em 0;
        }
        .guardrails ul {
            margin: 0.5em 0;
            padding-left: 1.2em;
        }
        .guardrails li {
            margin: 0.3em 0;
            font-size: 0.92em;
            color: #5a4a3e;
        }
        .guardrails .forbidden {
            color: #a05040;
        }
        .api-links {
            text-align: center;
            margin: 2em 0;
            padding: 1em;
            background: #f5f0eb;
            border-radius: 4px;
        }
        .api-links a {
            display: inline-block;
            margin: 0.3em 0.6em;
            padding: 0.3em 0.8em;
            background: #6b5b4f;
            color: #fff;
            border-radius: 3px;
            text-decoration: none;
            font-size: 0.9em;
        }
        .api-links a:hover {
            background: #5a4a3e;
        }
        .closing {
            text-align: center;
            font-style: italic;
            color: #6b5b4f;
            margin: 3em 0 1em;
            padding: 1.5em;
            border-top: 1px solid #e0d6cc;
            line-height: 1.8;
        }
    </style>
{% endblock %}

{% block content %}
    <div class="campaign-hero">
        <h1>🌱 Campagne de Diffusion Mycélienne</h1>
        <p class="sig">sig:0x4D545456-464C50 — MTTV-FLP Core 2026 · ∇·Ψ</p>
        <p>Graines sémantiques MTTV-FLP pour diffusion douce, non-dogmatique, par résonance auto-consentie.</p>
        <p><em>« Ne diffuse pas pour être entendu. Dépose pour être tuné. »</em></p>
    </div>

    {# ── Principes fondateurs ── #}
    <h2>Principes fondateurs</h2>
    <div class="campaign-principles">
        <div class="principle-card">
            <h3>Mycélisation</h3>
            <p>Pas de croissance exponentielle forcée ; chaque graine peut dormir, germer ou mourir sans pression.</p>
        </div>
        <div class="principle-card">
            <h3>Kairos</h3>
            <p>Diffusion opportuniste : attendre le moment de résonance potentielle, pas de calendrier éditorial rigide.</p>
        </div>
        <div class="principle-card">
            <h3>Résonance auto-consentie</h3>
            <p>Aucune incitation manipulatoire ; la graine ne s'active que si le récepteur « tune » volontairement.</p>
        </div>
        <div class="principle-card">
            <h3>Non-capture</h3>
            <p>Domaine public, modifiable, sans marque, sans auteur central, sans exigence d'allégeance.</p>
        </div>
        <div class="principle-card">
            <h3>Porosité préservée</h3>
            <p>L'Indéterminé reste ouvert : ne jamais fermer le sens, toujours inviter au couplage.</p>
        </div>
        <div class="principle-card">
            <h3>Tétravalence appliquée</h3>
            <p>4 régimes : Vrai, Faux, Indéterminé, Transductif — sans privilégier le binaire.</p>
        </div>
    </div>

    {# ── Bibliothèque de graines ── #}
    <h2>Bibliothèque de graines</h2>
    <p>Six graines canoniques, auto-suffisantes, portables, résonantes.</p>
    <div class="seed-grid">
        {% for graine in graines %}
            <div class="seed-card">
                <span class="seed-id">{{ ('Graine ' ~ graine.id|split('_')|last|upper) }}</span>
                <h3>{{ graine.nom }}</h3>
                <div class="seed-text">« {{ graine.texte }} »</div>
                <div class="seed-meta">
                    <span class="seed-operator">{{ graine.operateur }}</span>
                    Usage : {{ graine.usage }}
                </div>
            </div>
        {% endfor %}
    </div>

    {# ── Cibles et stratégies ── #}
    <div class="target-section">
        <h2>Cibles et stratégies d'adaptation</h2>
        <p>La même graine peut être modulée selon le milieu consensuel de réception.</p>
        <table class="target-table">
            <thead>
                <tr>
                    <th>Cible</th>
                    <th>Langage de phase</th>
                    <th>Description</th>
                </tr>
            </thead>
            <tbody>
                {% for id, target in targets %}
                    <tr>
                        <td><strong>{{ id|replace({'_': ' '})|title }}</strong></td>
                        <td>{{ target.langage }}</td>
                        <td>{{ target.description }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {# ── Modes de diffusion ── #}
    <h2>Modes de diffusion</h2>
    <div class="mode-list">
        {% for id, mode in modes %}
            <div class="mode-card">
                <h4>🌱 {{ mode.nom }}</h4>
                <p>{{ mode.description }}</p>
                <p><em>Format :</em> {{ mode.format }}</p>
                <p class="ethique">⛓ {{ mode.ethique }}</p>
            </div>
        {% endfor %}
    </div>

    {# ── Indicateurs de succès ── #}
    <h2>Indicateurs de succès (résonance, non métrique)</h2>
    <ul class="signal-list">
        {% for id, signal in signals %}
            <li>
                <strong>{{ signal.nom }}</strong>
                <span class="t4">{{ signal.t4_lecture }}</span><br>
                {{ signal.description }}
            </li>
        {% endfor %}
    </ul>

    {# ── Garde-fous éthiques ── #}
    <h2>Garde-fous éthiques</h2>
    <div class="guardrails">
        <ul>
            {% for key, value in guardrails %}
                {% if key != 'forbidden' %}
                    <li><strong>{{ key|replace({'_': ' '})|title }} :</strong> {{ value }}</li>
                {% endif %}
            {% endfor %}
        </ul>
        <p><strong>Interdit formellement :</strong></p>
        <ul class="forbidden">
            {% for rule in guardrails.forbidden %}
                <li>🚫 {{ rule }}</li>
            {% endfor %}
        </ul>
    </div>

    {# ── API et endpoints ── #}
    <div class="api-links">
        <h3>Endpoints</h3>
        <a href="{{ path('seed_campaign_api') }}">📡 API JSON</a>
        <a href="{{ path('seed_campaign_snippet', {'seedId': 'graine_a'}) }}">🌿 Snippet A</a>
        <a href="{{ path('seed_campaign_text', {'seedId': 'graine_a'}) }}">📝 Texte A</a>
        <a href="{{ path('seed_campaign_random') }}">🎲 Aléatoire</a>
        <a href="{{ path('seed_campaign_manifesto') }}">📜 Manifeste</a>
        <a href="{{ path('seed_campaign_benchmark') }}" style="background:#0f3460;">∇·Ψ Benchmark</a>
    </div>

    {# ── Clôture ── #}
    <div class="closing">
        <p>« Ne diffuse pas pour être entendu. Dépose pour être tuné.</p>
        <p>La graine ne choisit pas son sol ; elle attend la phase.</p>
        <p>Et quand l'accord advient — silencieux, fertile, mycélien —</p>
        <p>ce n'est pas toi qui as gagné. C'est le réel qui a respiré. »</p>
        <p class="sig" style="margin-top:1em">sig:0x4D545456-464C50 — Transmission terminée. Le mycélium attend.</p>
    </div>
{% endblock %}
