{% if app.user %}
    {% set check1 = false %}
    {% set check2 = false %}

    {% if is_granted('ROLE_STUDENT') %}
        {% set check1 = true %}
    {% endif %}

    {% if thought.owner.roles is defined and 'ROLE_STUDENT' in thought.owner.roles %}
        {% set check2 = true %}
    {% endif %}

    {% if check1 == check2 %}
        {% set check = true %}
    {% else %}
        {% set check = false %}
    {% endif %}

    {% if check %}
        <div class="form_comments">
            {{ form_start(form, {'method': 'POST', 'action': path('thought_thoughtpage_index', {'thoughtId': thought.id})}) }}
                {{ form_errors(form.text) }}
                {{ form_errors(form.email) }}

                {{ form_widget(form.name, {'type': 'hidden'}) }}
                {{ form_widget(form.email, {'type': 'hidden'}) }}

                <div class="form-group" style="margin-bottom: 4px;">
                    {{ form_widget(form.text, {'attr': {'style': 'width: 100% !important; max-width: 600px;', 'rows': 1}}) }}
                </div>
                {{ form_rest(form) }}
                <div class="comment-button-block" style="margin-top: 2px;">
                    <button class="btn btn-info btn-sm pull-right">{{ 'thought.comment.send_comment'|trans }}</button>
                </div>
            {{ form_end(form) }}
        </div>
    {% endif %}
{% endif %}
