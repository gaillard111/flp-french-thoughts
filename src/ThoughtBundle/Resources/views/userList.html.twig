{% extends 'ApplicationSonataUserBundle:Profile:action.html.twig' %}

{% block my_custom_menu %}
{% endblock %}

{% block sonata_profile_title %}
        User list
{% endblock %}

{% block sonata_profile_content %}
    {#{{ dump(users) }}#}
    <div class="row">
        <div class="col-sm-12">

            {% for user in users %}
                <div class="jumbotron user_jumbotron">
                    <p class="quote_title">
                        <a class="author_name" href="{{ path('thought_profile', { 'userId': user.id }) }}">
                            {{ user.firstname }} {{ user.lastname }}
                        </a>
                    </p>
                </div>
            {% endfor %}

        </div>
    </div>
    <div class="row">
        <div class="col-sm-12">
            <div class="navigation text-center">
                {{ knp_pagination_render(users) }}
            </div>
        </div>
    </div>
{% endblock %}