{% extends '@Thought/Profile/layout.html.twig' %}

{% form_theme form_info 'bootstrap_3_horizontal_layout.html.twig' %}
{% form_theme form_settings 'bootstrap_3_horizontal_layout.html.twig' %}

{% block sonata_profile_title %}
    {% if student %}
        Profile {{ student.firstname }}
    {% elseif user == app.user %}
        Mes paramètres
    {% else %}
        {{ user.firstname }} {{ user.lastname }}
    {% endif %}
{% endblock %}

{% block sonata_profile_content %}

    <div class="panel panel-info">
        <div class="panel-heading">Profil utilisateur</div>
        <div class="panel-body">
            {{ form(form_settings) }}
        </div>
    </div>

    <div class="panel panel-info">
        <div class="panel-heading">Mes paramètres</div>
        <div class="panel-body">
            {{ form(form_info) }}
        </div>
    </div>

{% endblock %}