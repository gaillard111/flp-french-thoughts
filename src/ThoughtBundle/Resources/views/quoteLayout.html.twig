<div class="jumbotron quote" data-quote="{{ thought.id }}">
    <p class="quote_title">
        <span>
            <a href="{{ path('thought_homepage_index', {'search[words]': thought.category, 'search[field][category]': 'on', 'search[strict]': 'on'}) }}">
                {{ thought.category }}
            </a>
        </span>
        {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_MODERATOR') %}
            <span class="quote_edit">
                <a href="{{ path('admin_thought_thought_edit', {'id': thought.id}) }}">
                    {{ 'user.thought.list_page.link.edit'|trans }}
                </a>
            </span>
        {% endif %}

    </p>
    <p class="quote_content">
        <span>{{ thought.content|customTag|raw|nl2br }}</span>
    </p>
    <p>
        <strong>{{ 'thought.property.author'|trans|capitalize }}:</strong>
        <span class="author">
            <a href="{{ path('thought_homepage_index', {'search[words]': thought.author, 'search[field][author]': 'on', 'search[strict]': 'on'}) }}">
                {{ thought.author }}
            </a>
        </span>

        {% set author = thought.author|authorsInfo %}

        {#{% if author %}#}
            {#<span class="hoverable_name">({{ 'thought.property.hoverable'|trans}})</span>#}
        {#{% endif %}#}
    </p>

    {% if author %}
        <div class="authors_info" style="display: none;">

            <p><strong>{{ 'author.filter.fields.birthDate.label'|trans }}:</strong> <span>{{ author.birthDate }}</span></p>
            <p><strong>{{ 'author.filter.fields.country.label'|trans }}:</strong> <span>{{ author.country }}</span></p>
            <p><strong>{{ 'author.filter.fields.sex.label'|trans }}:</strong> <span>{{ author.sex }}</span></p>
            <p><strong>{{ 'author.filter.fields.job.label'|trans }}:</strong> <span>{{ author.job }}</span></p>
            <p><strong>{{ 'author.filter.fields.continent.label'|trans }}:</strong> <span>{{ author.continent }}</span></p>
        </div>
    {% endif %}


    <p>
        <strong>{{ 'thought.property.thoughtInfo'|trans|capitalize }}:</strong>
        <span>{{ thought.thoughtInfo }}</span>
    </p>
    <p class="quote_tags">
            <span>
                {% for tag in thought.tags|split(' , ') %}
                    {% if tag|trim|length > 0 %}
                        [<a href="{{ path('thought_homepage_index', {'search[words]': tag, 'search[field][tags]': 'on'}) }}">
                        <span>{{ tag }}</span>
                    </a>]
                    {% endif %}
                {% endfor %}
            </span>
    </p>
    <p>
        {% set liked = (thought.id in app.request.cookies.get('quotes')|split(',')) ? true : false %}
        <button class="btn btn-info btn-sm like-quote" data-quote="{{ thought.id }}" type="button">
                <span class="badge-text">
                    {{ liked ? 'thought.property.liked'|trans : 'thought.property.like'|trans }}
                </span> <span class="badge" style="display: {{ (thought.liked > 0) ? 'inline-block' : 'none' }}">{{ thought.liked }}</span>
        </button>

        {% if app.request.get('thoughtId') == null %}
            <a class="page_quote_button btn btn-info btn-sm" href="{{ path('thought_thoughtpage_index', {'thoughtId': thought.id}) }}">
                {{ 'thought.comment.page_quote'|trans }}
            </a>
        {% endif %}
    </p>
    {% set already_chains = [] %}
    {% for arr_chain in thought.chainThoughts %}
        {% set already_chains = already_chains|merge([arr_chain.chain.name]) %}
    {% endfor %}
    <div class="row">
        {#{% if thought.comments.count > 0 %}#}
        <div class="col-sm-12">
            <div class="row">
                <div class="col-sm-12 ">
                    {% if thought.comments|length and app.request.get('_route') == 'thought_homepage_index' %}
                        <a class="show-link" data-id="{{ thought.id }}">{{ 'thought.comment.quantity_comments'|trans }}: {{ thought.comments|length }}</a>
                    {% else %}
                        <p>{{ 'thought.comment.quantity_comments'|trans }}: {{ thought.comments|length }}</p>
                    {% endif %}
                </div>
            </div>
            <div class="row">
                <div class="col-sm-12 comments hidden" data-id="{{ thought.id }}">
                    {% for thoughtComments in comments[thought.id] %}
                        {% for comment in thoughtComments %}
                            <p class="profile-link"><a href="">{{ comment.name }}</a></p>
                            <p class="comment-data">{{ comment.createdAt|date('d.m.Y') }}</p>
                            <p>{{ comment.text }}</p>
                        {% endfor %}
                    {% endfor %}
                </div>
            </div>
        </div>
        {#{% endif %}#}
        <div class="col-sm-6 pull-left">
            <div class="row">
                <div class="col-sm-12">
                    {% if thought.owner %}
                        <span>
                        {{ 'thought.chain.added_to_site'|trans }}
                            <a href="{{ path('thought_profile', { 'userId': thought.owner.id } ) }}">
                               {{ thought.owner.firstname }}
                            </a>
                        </span>
                    {% endif %}
                </div>
                <div class="col-sm-12">
                    {% if chainId is defined %}
                        {% if app.user %}
                            {% if already_chains|length %}
                                {% for chainThought in thought.chainThoughts %}
                                    {% if chainThought.user != null and chainThought.chain.id == chainId %}
                                        <span>
                                            {{ 'thought.chain.added_by'|trans }}
                                            <a href="{{ path('thought_profile', { 'userId': chainThought.user.id } ) }}">
                                               {{ chainThought.user.firstname }}
                                            </a>

                                        </span>
                                    {% endif %}
                                {% endfor %}
                            {% endif %}
                        {% endif %}
                    {% endif %}
                </div>
            </div>
        </div>
        <div class="col-sm-6">
            {% if already_chains|length %}
                <span class="is-added pull-right" data-toggle="tooltip" data-placement="bottom" title="{{ 'thought.chain.added_to_chain'|trans }} {{ already_chains|join(', ') }}">
                    {{ 'thought.chain.already_added'|trans }}
                </span>
            {% endif %}
        </div>

    </div>

    {% if app.user %}
        <div class="row">
            <div class="col-xs-12 col-lg-6 chain-row">
                <div class="quote_chain">
                    <div class="row">
                        <div class="col-xs-9 col-lg-10">
                            <select class="w100" name="quote_collective_chain">
                                <option value="">{{ 'thought.chain.add_quote_collective'|trans }}</option>
                                {% for chain in colChains %}
                                    {% if chain.name not in already_chains %}
                                        <option value="{{ chain.id }}">{{ chain.name }}</option>
                                    {% endif %}
                                {% endfor %}
                            </select>
                        </div>
                        <div class="col-xs-3 col-lg-2 chain-button">
                            <a href="#" class="add_collective_chain btn btn-info btn-xs w100">{{ 'thought.chain.add_to_collective_chain'|trans }}</a>
                        </div>

                    </div>

                </div>
            </div>
            <div class="col-xs-12 col-lg-6 chain-row">
                <div class="quote_chain">
                    <div class="row">
                        <div class="col-xs-9 col-lg-10">
                            <select class="w100" name="quote_chain">
                                <option value="">{{ 'thought.chain.add_quote'|trans }}</option>

                                {% for chain in app.user.chains %}
                                    {% if chain.name not in already_chains %}
                                        <option value="{{ chain.id }}">{{ chain.name }}</option>
                                    {% endif %}
                                {% endfor %}
                            </select>
                        </div>
                        <div class="col-xs-3 col-lg-2 chain-button">
                            <a href="#" class="add_chain btn btn-info btn-xs w100">{{ 'thought.chain.add_to_chain'|trans }}</a>
                        </div>

                    </div>

                </div>
            </div>
        </div>
        {% endif %}

    {#{{ dump(already_chains) }}#}


    {#{% if app.request.get('thoughtId') == null %}#}
        {#<p>#}
            {#<a class="btn btn-info btn-sm" href="{{ path('thought_thoughtpage_index', {'thoughtId': thought.id}) }}">#}
                {#{{ 'thought.comment.page_quote'|trans }}#}
            {#</a>#}
        {#</p>#}
    {#{% endif %}#}
</div>