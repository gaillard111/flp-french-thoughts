<div class="jumbotron quote" data-quote="{{ thought.id }}">

    {% if thought.owner.roles is defined and 'ROLE_STUDENT' not in thought.owner.roles and is_granted('ROLE_STUDENT') %}
        <span class="thought-lable label label-warning">Véritable Cination non validée</span>
    {% endif %}

    <p class="quote_title">
        <span>
            <a href="{{ path('thought_homepage_index', {'search[words]': thought.category, 'search[field][category]': 'on', 'search[strict]': 'on'}) }}">
                {{ thought.category }}
            </a>
        </span>

        {% if app.user %}
            {% set editThought = false %}
            {% if thought.owner is defined and thought.owner is not null %}
                {% if thought.owner.id == app.user.id %}
                    {% set editThought = true %}
                {% endif %}
            {% endif %}

            {% if is_granted('ROLE_MODERATOR') %}
                {% set editThought = true %}
            {% endif %}
            {% if editThought %}
                <span class="quote_edit">
                    <a href="{{ path('sonata_user_thought_edit', {'id': thought.id}) }}">
                        {{ 'user.thought.list_page.link.edit'|trans }}
                    </a>
                </span>
            {% endif %}
        {% endif %}

    </p>
    <p class="quote_content">
        <span>{{ thought.content|customTag|raw|nl2br }}</span>
    </p>
    <p>
        <strong>{{ 'thought.property.author'|trans|capitalize }}:</strong>
        <span class="author">
            <a href="{{ path('thought_homepage_index', {'search[words]': thought.author, 'search[field][author]': 'on', 'search[strict]': 'on'}) }}">
                {{ thought.author }}
            </a>
        </span>

        {% set author = thought.author|authorsInfo %}
    </p>

    {% if author %}
        <div class="authors_info" style="display: none;">

            <p><strong>{{ 'author.filter.fields.birthDate.label'|trans }}:</strong> <span>{{ author.birthDate }}</span></p>
            <p><strong>{{ 'author.filter.fields.country.label'|trans }}:</strong> <span>{{ author.country }}</span></p>
            <p><strong>{{ 'author.filter.fields.sex.label'|trans }}:</strong> <span>{{ author.sex }}</span></p>
            <p><strong>{{ 'author.filter.fields.job.label'|trans }}:</strong> <span>{{ author.job }}</span></p>
            <p><strong>{{ 'author.filter.fields.continent.label'|trans }}:</strong> <span>{{ author.continent }}</span></p>
        </div>
    {% endif %}


    <p>
        <strong>{{ 'thought.property.thoughtInfo'|trans|capitalize }}:</strong>
        <span>{{ thought.thoughtInfo }}</span>
    </p>
    <p class="quote_tags">
            <span>
                {% for tag in thought.tags|split(' , ') %}
                    {% if tag|trim|length > 0 %}
                        [<a href="{{ path('thought_homepage_index', {'search[words]': tag, 'search[field][tags]': 'on'}) }}">
                        <span>{{ tag }}</span>
                    </a>]
                    {% endif %}
                {% endfor %}
            </span>
    </p>
    <p>

        {% set liked = thought.likes %}
{#        {% if is_granted('ROLE_USER') %}#}
            <button class="btn btn-info btn-sm {% if app.user %} like-quote {% else %} like-popup {% endif %}" data-quote="{{ thought.id }}" type="button">
                    <span data-toggle="tooltip" data-html="true" data-placement="bottom" title="{{ include('@ApplicationSonataUser/Thought/also_liked_tooltip.html.twig') }}">
                        <span class="badge-text">
                            {{ liked ? 'thought.property.liked'|trans : 'thought.property.like'|trans }}
                        </span> <span class="badge" style="display: {{ (thought.likes.count > 0) ? 'inline-block' : 'none' }}">{{ thought.likes.count }}</span>
                    </span>
            </button>
{#        {% endif %}#}

        {% if app.request.get('thoughtId') == null %}
            <a class="page_quote_button btn btn-info btn-sm" href="{{ path('thought_thoughtpage_index', {'thoughtId': thought.id}) }}">
                {{ 'thought.comment.page_quote'|trans }}
            </a>
        {% endif %}
    </p>
    {% set already_chains = [] %}
    {% for arr_chain in thought.chainThoughts %}
        {% set already_chains = already_chains|merge([{name: arr_chain.chain.name, id: arr_chain.chain.id}]) %}
    {% endfor %}
    <div class="row">
        <div class="col-sm-12">
            <div class="row">
                <div class="col-sm-12 ">
                    {% if thought.comments|length and app.request.get('_route') == 'thought_homepage_index' %}
                        <a class="show-link" data-id="{{ thought.id }}">{{ 'thought.comment.quantity_comments'|trans }}: {{ thought.comments|length }}</a>
                    {% else %}
                        <p>{{ 'thought.comment.quantity_comments'|trans }}: {{ thought.comments|length }}</p>
                    {% endif %}
                </div>
            </div>
            <div class="row">
                <div class="col-sm-12 comments hidden" data-id="{{ thought.id }}">
                    {% for thoughtComments in comments[thought.id] %}
                        {% for comment in thoughtComments %}
                            <p class="profile-link"><a href="">{{ comment.name }}</a></p>
                            <p class="comment-data">{{ comment.createdAt|date('d.m.Y') }}</p>
                            <p>{{ comment.text }}</p>
                        {% endfor %}
                    {% endfor %}
                </div>
            </div>
        </div>
        {% if thought.owner %}
            <div class="row">
                <div class="col-sm-12 related-thoughts-block">
                    <a class="related-thoughts-label">Citations liées:</a>
                    <div class="related-thoughts">
                        {% for counter, thought in thought.owner.thoughts %}
                            {% if counter < 50 %}
                                <a href="{{ path('thought_thoughtpage_index', {'thoughtId': thought.id}) }}">{{ thought.category }}</a>
                            {% endif %}
                        {% endfor %}
                    </div>

                </div>
            </div>
        {% endif %}
        <div class="col-sm-6 pull-left">
            <div class="row">
                <div class="col-sm-12">
                    {% if thought.owner %}
                        <span>
                        {{ 'thought.chain.added_to_site'|trans }}
                            <a href="{{ path('thought_profile', { 'userId': thought.owner.id } ) }}">
                               {{ thought.owner.firstname }}
                            </a>
                        </span>
                    {% endif %}
                </div>
                <div class="col-sm-12">
                    {% if chainId is defined %}
                        {% if app.user %}
                            {% if already_chains|length %}
                                {% for chainThought in thought.chainThoughts %}
                                    {% if chainThought.user != null and chainThought.chain.id == chainId %}
                                        <span>
                                            {{ 'thought.chain.added_by'|trans }}
                                            <a href="{{ path('thought_profile', { 'userId': chainThought.user.id } ) }}">
                                               {{ chainThought.user.firstname }}
                                            </a>
                                        </span>
                                    {% endif %}
                                {% endfor %}
                            {% endif %}
                        {% endif %}
                    {% endif %}
                </div>
            </div>
        </div>
        <div class="col-sm-6">
            {% if already_chains|length %}
                {% set template = '@Thought/include/chainsTooltip.html.twig'  %}
                <span class="is-added pull-right hastooltip" data-toggle="tooltip" data-placement="bottom" data-html="true" title="{{ 'thought.chain.added_to_chain'|trans }} {{ include(template)|escape }}">
                    {{ 'thought.chain.already_added'|trans }}
                </span>
            {% endif %}
        </div>

    </div>

    {% set check1 = false %}
    {% set check2 = false %}

    {% if is_granted('ROLE_STUDENT') %}
        {% set check1 = true %}
    {% endif %}

    {% if thought.owner.roles is defined and 'ROLE_STUDENT' in thought.owner.roles %}
        {% set check2 = true %}
    {% endif %}

    {% if check1 == check2 %}
        {% set check = true %}
    {% else %}
        {% set check = false %}
    {% endif %}

    {% if app.user and check %}
        <div class="row">
            <div class="col-sm-6 pull-left quote_chain" id="thought-{{ thought.id }}">
                <div class="btn-group">
                    <button type="button" class="btn btn-info btn-sm dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                        {{ 'thought.chain.add_quote_collective'|trans }} <span class="caret"></span>
                    </button>
                    <ul class="dropdown-menu" role="menu" aria-labelledby="dropdownMenu">
                        {% for topic in topicsArray %}
                            {% if topic['topic_chains'] is not empty %}
                                <li class="dropdown-submenu">
                                    <a tabindex="-1" >{{ topic['topic_name'] }}</a>
                                    <ul class="dropdown-menu chains-selector">
                                        {% for chain in topic['topic_chains']  %}

                                            {% set switcher = '' %}             {# To disable after аdditions #}
                                            {% set type = 'private' %}
                                            {% for already_chain in already_chains %}
                                                {% if already_chain.id == chain.id %}
                                                    {% set switcher = 'disabled' %}
                                                {% endif %}
                                            {% endfor %}

                                            {% if not chain.isPrivate %}        {# type chains after name in selector #}
                                                {% if chain.isCollective %}
                                                    {% set type = 'collective' %}
                                                {% else %}
                                                    {% set type = 'publiques' %}
                                                {% endif %}
                                            {% endif %}

                                            {% if chain in colChains or chain in app.user.chains  %}
                                                <li class="chain {{ switcher }}" id="{{ chain.id }}"><a>{{ chain.name }} ({{ type }})</a></li>
                                            {% endif %}

                                        {% endfor %}
                                    </ul>
                                </li>
                            {% endif %}
                        {% endfor%}
                    </ul>
                </div>
            </div>
        </div>
    {% endif %}
</div>