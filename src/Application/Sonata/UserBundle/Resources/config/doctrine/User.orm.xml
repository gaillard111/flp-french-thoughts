<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                  http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="Application\Sonata\UserBundle\Entity\User" table="fos_user_user">

        <id name="id" column="id" type="integer">
            <generator strategy="AUTO" />
        </id>
        <one-to-many
                field="thoughts"
                target-entity="ThoughtBundle\Entity\Thought"
                mapped-by="owner" />

        <one-to-many
                field="chains"
                target-entity="ThoughtBundle\Entity\Chain"
                mapped-by="user" />

        <one-to-many
                field="chainComments"
                target-entity="ThoughtBundle\Entity\ChainComment"
                mapped-by="user" />

        <one-to-many
                field="friendship"
                target-entity="Application\Sonata\UserBundle\Entity\Friendship"
                mapped-by="user"
                 />

        <one-to-many
                field="friends"
                target-entity="Application\Sonata\UserBundle\Entity\Friendship"
                mapped-by="friend"
        />

        <one-to-many
                field="collectiveThoughtChains"
                target-entity="ThoughtBundle\Entity\ThoughtChain"
                mapped-by="user"
        />

        <many-to-many
                field="dialogs"
                mappedBy="users"
                target-entity="Application\Sonata\UserBundle\Entity\Dialog"
        />

        <one-to-many
                field="topics"
                target-entity="ThoughtBundle\Entity\Topic"
                mapped-by="user"
        />

        <one-to-many
                field="likes"
                target-entity="ThoughtBundle\Entity\Like"
                mapped-by="user"
        />

        <many-to-many field="mostFavoriteThoughts" target-entity="ThoughtBundle\Entity\Thought">
            <join-table name="favorite_thoughts">
                <join-columns>
                    <join-column name="user_id" referenced-column-name="id" />
                </join-columns>
                <inverse-join-columns>
                    <join-column name="thought_id" referenced-column-name="id" />
                </inverse-join-columns>
            </join-table>
        </many-to-many>

        <field name="about" type="text" nullable="true"/>
        <field name="country" type="string" length="255" nullable="true"/>
        <field name="interests" type="text" nullable="true"/>


    </entity>

</doctrine-mapping>
