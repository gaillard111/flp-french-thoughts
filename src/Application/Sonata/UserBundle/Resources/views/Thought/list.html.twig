{% extends 'ApplicationSonataUserBundle:Profile:action.html.twig' %}

{% block sonata_profile_title %}{{ 'user.thought.list_page.title'|trans }}{% endblock %}

{% block sonata_profile_content %}
    <div class="row">
        <div class="col-sm-12">
            {#<p><a href="{{ path('sonata_user_thought_create') }}" class="btn btn-info">{{ 'user.thought.list_page.add_button'|trans }}</a></p>#}
            <div class="table-responsive">
                <table class="table">
                    <thead>
                    <tr>
                        <th>#</th>
                        <th>{{ 'thought.property.content'|trans }}</th>
                        <th>{{ 'thought.property.author'|trans }}</th>
                        <th>{{ 'thought.property.category'|trans }}</th>
                        <th>{{ 'thought.property.publish'|trans }}</th>
                        {#<th>{{ 'user.thought.list_page.table.action'|trans }}</th>#}
                    </tr>
                    </thead>
                    <tbody>
                    {% for thought in thoughts %}
                        <tr>
                            <td>{{ loop.index }}</td>
                            <td>{{ thought.content|slice(0, 50)}}</td>
                            <td>{{ thought.author }}</td>
                            <td>{{ thought.category }}</td>
                            <td>
                        <span class="label label-{{ thought.published ? 'success' : 'danger' }}">
                            {{ thought.published ? 'Yes' : 'No' }}
                        </span>
                            </td>
                            {#<td>
                                <ul>
                                    <li><a href="#">{{ 'user.thought.list_page.link.edit'|trans }}</a></li>
                                    <li><a href="#">{{ 'user.thought.list_page.link.delete'|trans }}</a></li>
                                </ul>
                            </td>#}
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>

        </div>
    </div>

{% endblock %}


