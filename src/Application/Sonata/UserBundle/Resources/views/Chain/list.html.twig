{% extends 'ApplicationSonataUserBundle:Profile:action.html.twig' %}

{% block sonata_profile_title %}{{ 'user.chain.list_page.title'|trans }}{% endblock %}

{% block sonata_profile_content %}
    {% block chain_navigation %}
        {{ render(controller('ApplicationSonataUserBundle:Chain:navigation', { 'routeName': app.request.get('_route') })) }}
    {% endblock %}
    <p><a href="{{ path('sonata_user_chain_create') }}" class="btn btn-info">{{ 'user.chain.list_page.add_button'|trans }}</a></p>
    <div class="row">

                {#<thead>#}
                {#<tr>#}
                    {#<th>#</th>#}
                    {#<th>{{ 'chain.property.name.title'|trans }}</th>#}
                    {#<th>Topic</th>#}
                    {#<th>{{ 'chain.property.created'|trans }}</th>#}
                    {#<th>{{ 'chain.property.private'|trans }}</th>#}
                    {#<th>{{ 'chain.property.quantity_quotes'|trans }}</th>#}
                    {#<th></th>#}
                {#</tr>#}
                {#</thead>#}

            {#<table class="table table-borderless">#}
                {#<tbody>#}
                {% for chain in chains %}
                    {#<tr>#}
                        {#<td>{{ loop.index }}</td>#}
                        <div class="col-sm-4 chain-list">
                            <a class="chain-item" data-html="true" data-toggle="tooltip" data-placement="bottom" title="
                            <div>
                                Status:
                                {% if chain.isPrivate %}
                                    Private
                                {% else %}
                                    Public,
                                    {% if chain.isCollective %}
                                        collective
                                    {% else %}
                                        personally
                                    {% endif %}
                                {% endif %}
                            </div>
                            <div>
                                Quotes: {{ chain.chainThoughts|length }}
                            </div>
                            <div>
                                Created: {{ chain.createdAt|date('d.m.Y') }}
                            </div>
                            " href="{{ path('chain_page', {'chainId': chain.id}) }}">{{ chain.name }}</a>
                            {% if chain.isPrivate == false %}
                                {#( {{ url('chain_page', {'chainId': chain.id}) }} )#}
                                (<a href="{{ path('thought_profile', { 'userId': chain.user.id }) }}">{{ chain.user.firstname }}</a>, {{ chain.id }})
                            {% endif %}
                            <div class="pull-right">
                                <a class="text-primary" href="{{ path('sonata_user_chain_edit', {'chainId': chain.id}) }}">
                                    <span class="glyphicon glyphicon-pencil" aria-hidden="true"></span>
                                </a>
                                <a class="chain-remove text-danger" href="{{ path('sonata_user_chain_remove', {'chainId': chain.id}) }}">
                                    <span class="glyphicon glyphicon-remove" aria-hidden="true"></span>
                                </a>
                            </div>

                        </div>
                        {#<td>#}
                            {#{% if chain.topic is not null %}#}
                                {#{{ chain.topic.name }}#}
                            {#{% endif %}#}
                        {#</td>#}
                        {#<td>{{ chain.createdAt|date('Y-m-d') }}</td>#}
                        {#<td>#}
                            {#<p>#}
                                {#<span class="label label-{{ chain.isPrivate ? 'danger' : 'success' }}">#}
                                    {#{{ chain.isPrivate ? 'Private' : 'Public' }}#}
                                {#</span>&nbsp;#}
                            {#{% if chain.isPrivate %}#}
                                    {#<a href="{{ path('sonata_user_chain_share', {'chainId': chain.id}) }}">#}
                                        {#{{ 'chain.property.shared?'|trans }}#}
                                    {#</a>#}
                                {#{% else %}#}
                                    {#<a href="{{ path('sonata_user_chain_share', {'chainId': chain.id }) }}">#}
                                        {#{{ 'chain.property.private?'|trans }}#}
                                    {#</a>#}
                            {#</p>#}

                            {#<p>#}
                                {#<span class="label label-{{ chain.isCollective ? 'success' : 'danger' }}">#}
                                    {#{{ chain.isCollective ? 'Collective' : 'Personally' }}#}
                                {#</span>&nbsp;#}
                                {#{% if chain.isCollective %}#}
                                    {#<a href="{{ path('sonata_user_chain_collective', {'chainId': chain.id }) }}">#}
                                        {#{{ 'chain.property.personally?'|trans }}#}
                                    {#</a>#}
                                {#{% else %}#}
                                    {#<a href="{{ path('sonata_user_chain_collective', {'chainId': chain.id }) }}">#}
                                        {#{{ 'chain.property.collective?'|trans }}#}
                                    {#</a>#}
                                {#{% endif %}#}
                            {#</p>#}

                            {#{% endif %}#}
                        {#</td>#}
                        {#<td>{{ chain.chainThoughts|length }}</td>#}
                        {#<td>#}
                            {##}
                        {#</td>#}
                    {#</tr>#}
                {% endfor %}
                {#</tbody>#}
            {#</table>#}
            <div class="navigation text-center">
                {{ knp_pagination_render(chains) }}
            </div>
        </div>

{% endblock %}
{% block right_sidebar %}
    {#{{ dump() }}#}
    {{ render(controller('ApplicationSonataUserBundle:Chain:rightSidebar', { 'routeName': app.request.get('_route'), 'curTopicId': app.request.attributes.get('topicId') })) }}
{% endblock %}