{% extends 'ApplicationSonataUserBundle::layout.html.twig' %}

{% block sonata_page_breadcrumb %}
    {% if breadcrumb_context is not defined %}
        {% set breadcrumb_context = 'user_index' %}
    {% endif %}
    <div class="row-fluid clearfix">
        {{ sonata_block_render_event('breadcrumb', { 'context': breadcrumb_context, 'current_uri': app.request.requestUri }) }}
    </div>
{% endblock %}

{% block fos_user_content %}
    <h2>{% block sonata_profile_title %}{% trans from 'SonataUserBundle' %}sonata_profile_title{% endtrans %}{% endblock %}</h2>



    <div class="row">
        {% block my_custom_menu %}
            <div class="col-md-2 hidden-sm hidden-xs">
                <div class="row">
                    <div class="panel">
                        <div class="panel-body my-custom-menu">
                            <div class="row">
                                {{ render(controller('ApplicationSonataUserBundle:Thought:menu', { 'routeName': app.request.get('_route') })) }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% endblock %}
            <div class="col-md-8 col-sm-12">
                {% include 'SonataCoreBundle:FlashMessage:render.html.twig' %}

                {% block sonata_profile_content %}{% endblock %}
            </div>
            <div class="col-md-2 hidden-sm hidden-xs">{% block right_sidebar %}{% endblock %}</div>





    </div>
{% endblock %}