{% extends "SonataUserBundle:Profile:action.html.twig" %}

{% block sonata_profile_title %}
    {{ 'user.dialogs.title'|trans }}
{% endblock %}

{% block sonata_profile_content %}
    <div class="row">
        <div class="col-sm-12">
            <div class="row">
                <div class="col-sm-12 col-lg-10">
                    {{ form_start(form) }}
                    <div class="form-group">
                        {{ form_label(form.messageText) }}
                        {{ form_widget(form.messageText) }}
                    </div>
                    {{ form_end(form) }}
                </div>

            </div>

            <div class="media">

                {% for user in dialog.users %}
                    {% if user == app.user %}
                        {% if messages %}
                            {% for message in messages.items %}

                                <div class="row">
                                    <div class="col-sm-12 col-lg-10">
                                        <div class="panel panel-info
                                            {% if message.sender == app.user %}
                                                pull-right
                                            {% else %}
                                                pull-left
                                            {% endif %}
                                            col-sm-10 col-md-9">
                                            <div class="panel-heading row">
                                                <div class="col-sm-6">
                                                    <strong>
                                                        {#Message #{{ message.id }} by#}
                                                        <a href="{{ path('thought_profile', { 'userId': message.sender.id }) }}">
                                                            {#{{ message.sender.id }}#} {{ message.sender.firstname }} {{ message.sender.lastname }}
                                                        </a>
                                                    </strong>
                                                </div>

                                                {#<span class="text-muted">commented 5 days ago</span>#}
                                                <div class="col-sm-6 text-right">
                                                    {{ message.createdAt|date('Y-m-d H:i') }}
                                                </div>
                                            </div>
                                            <div class="panel-body">
                                                {{ message.messageText }}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        {% endif %}
                    {% endif %}
                {% endfor %}

            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-sm-12 text-center">
            {{ knp_pagination_render(messages) }}
        </div>
    </div>

{% endblock %}