<div class="container">
    <div class="row">
        <div class="col-sm-8">
            <div class="table-responsive">
                <table class="table table-borderless">
                    <tbody>
                    {% for friendship in friendships %}
                        {% if friendship.user.id == app.user.id %}
                            {% set friend = friendship.friend %}
                        {% else %}
                            {% set friend = friendship.user %}
                        {% endif %}

                        <tr>
                            <td><a href="{{ path('thought_profile', { 'userId': friend.id  } ) }}">{{ friend.firstname }} {{ friend.lastname }}</a></td>
                            <td></td>
                            <td>{{ friend.email }}</td>
                            {% if friendship.user.id == app.user.id %}
                                {% set friend = friendship.friend %}
                                <th></th>
                            {% else %}
                                {% set friend = friendship.user %}
                                <th><a href="{{ path('accept_friend_request', { 'requestId': friendship.id }) }}">Accept</a></th>
                            {% endif %}
                            <th><a href="{{ path('delete_friend', { 'userId': friendship.friend.id }) }}">supprimer</a></th>
                        </tr>

                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>