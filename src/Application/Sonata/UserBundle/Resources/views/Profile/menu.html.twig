<div class="list-group">
    {% for item in menu %}
        <a class="list-group-item
            {% if routeName == item.route  %}
                {% if routeName != 'thought_profile' %}
                    {% if curTopicId is defined %}
                        {% if item.parameters is defined %}
                            {% if curTopicId == item.parameters.topicId %}
                                active
                            {% endif %}
                        {% endif %}
                    {% else %}
                        active
                    {% endif %}
                    {% if item.route == 'sonata_user_chains' %}
                        {% if item.parameters is not defined %}
                            active
                        {% endif %}
                    {% endif %}
                {% elseif userProfileId == app.user.id %}
                    active
                {% endif %}
            {% else %}
                {% if routeName == 'dialog' and item.route == 'dialog_list' %}
                    {#active#}
                {% endif %}
                {% if routeName == 'sonata_user_chain_by_topic' and item.route == 'sonata_user_chains' %}
                    {% if item.label != 'All' %}
                        active
                    {% endif %}
                {% endif %}
                {% if routeName == 'sonata_user_favorite_chains' and item.route == 'sonata_user_chains' %}
                    active
                {% endif %}
                {% if routeName == 'sonata_user_shared_chains' and item.route == 'sonata_user_chains' %}
                    active
                {% endif %}
                {% if routeName == 'chain_collective' and item.route == 'sonata_user_chains' %}
                    active
                {% endif %}
                {#{% if routeName == 'all_topics' and item.route == 'sonata_user_topics' %}#}
                    {#active#}
                {#{% endif %}#}
            {% endif %}
            {% if item.parameters is defined %}
            " href="{{ path(item.route, item.parameters) }}
            {% else %}
            " href="{{ path(item.route) }}
            {% endif %}
            ">{{ item.label|slice(0, 20) }}
            {% if item.route == 'sonata_user_thoughts' %}
                ({{ thoughts }})
            {% endif %}
            {% if item.route == 'friend_requests' %}
                ({{ requestsCount }})
            {% endif %}
            {% if item.route == 'dialog_list' and newMessagesCount[1] != 0 %}
                    <span id="messages-counter">(+{{ newMessagesCount[1] }})</span>
            {% endif %}
            {% if item.route == 'sonata_user_topics' %}
                ({{ countTopics[1] }})
            {% endif %}
        </a>
    {% endfor %}
</div>
<script>
    $(document).ready(function () {
        // $(window).focus(function () {
            setInterval(function () {
                $.ajax({
                    url:        "{{ path('ajax_counter') }}",
                    method:     "POST",
                    success:    function (data) {
                        console.log(data);
                        $("#messages-counter").html('(+' + data['count'][1] + ')');
                    }
                });
            }, 30000);
        // });
    });
</script>