{% extends "SonataUserBundle:Profile:action.html.twig" %}

{% block sonata_profile_title %}
    {{ 'user.dialogs.title'|trans }}
{% endblock %}

{% block sonata_profile_content %}
    <div class="row">
        <div class="col-sm-12">
            <div class="media">
                {% for dialog in dialogs %}
                        <div class="row">
                            <div class="col-sm-6">
                                {#<div class="media-left">#}
                                    {#<a href="#">#}
                                    {#<img class="media-object" src="..." alt="...">#}
                                    {#</a>#}
                                {#</div>#}
                                <div class="message_preview">
                                    <div class="media-body">
                                        <h4 class="media-heading">

                                        <a href="{{ path('dialog', { 'dialogId': dialog.id }) }}">
                                            {% for user in dialog.users %}
                                                {% if user != app.user %}
                                                    {{ user.firstname }} {{ user.lastname }}
                                                {% endif %}
                                            {% endfor %}
                                            {#{% dump dialog.users %}#}
                                        </a>
                                        </h4>

                                            <p>

                                                {% for message in lastMessages %}
                                                    {% if message.dialog.id == dialog.id %}
                                                        {{ message.messageText }}
                                                    {% endif %}
                                                {% endfor %}
                                            </p>


                                    </div>
                                </div>
                            </div>
                        </div>
                        {#{% endif %}#}

                {% endfor %}
            </div>
        </div>
    </div>
{% endblock %}