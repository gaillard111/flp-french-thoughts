{% form_theme form '@ApplicationSonataUser/Profile/Form/form-change-password-content.html.twig' %}

<script>
    $(document).ready(function () {

        grecaptcha.ready(function () {
            grecaptcha.render('captcha', {
                'sitekey' : '6Lf0gnIUAAAAAIOcDJST9QKJdz7KhbvcacgvizF5',
                'callback' : function (token) {
                    // console.log(token);
                    $('[id=front_user_registration_form_reCaptcha]').attr('value', token );
                    $('[id=registerForm]').submit();
                }
            });
        });

        // $('#registerForm').submit(function(event) {
        //
        //     event.preventDefault();
        //     event.stopPropagation();
        // });
    });
</script>




<div class="panel panel-info">
    <div class="panel-heading">
        <h2 class="panel-title">{{ 'navbar.registration'|trans }}</h2>
    </div>
    <div class="panel-body">
        <form action="{{ path('fos_user_registration_register') }}" {{ form_enctype(form) }} method="POST" id="registerForm" class="fos_user_registration_register form-horizontal">

            {{ form_widget(form) }}

            <div class="form-actions col-sm-7">
               <input
                        type="submit"
                        value="{{ 'user.form.registration.button'|trans({}, 'messages') }}"
                        class="btn btn-info pull-right"
                        id="captcha"
                />
            </div>
        </form>
    </div>
</div>

<script src='https://www.google.com/recaptcha/api.js?render=6Lf0gnIUAAAAAIOcDJST9QKJdz7KhbvcacgvizF5'></script>