{% form_theme form '@ApplicationSonataUser/Profile/Form/form-change-password-content.html.twig' %}

<div class="panel panel-info">
    <div class="panel-heading">
        <h2 class="panel-title">{{ 'title_user_registration'|trans({}, 'SonataUserBundle') }}</h2>
    </div>
    <div class="panel-body">
        <form action="{{ path('fos_user_registration_register') }}" {{ form_enctype(form) }} method="POST" class="fos_user_registration_register form-horizontal">

            {{ form_widget(form) }}

            <div class="form-actions col-sm-7">
                <input type="submit" value="{{ 'user.form.registration.button'|trans({}, 'messages') }}" class="btn btn-info pull-right" />
            </div>
        </form>
    </div>
</div>