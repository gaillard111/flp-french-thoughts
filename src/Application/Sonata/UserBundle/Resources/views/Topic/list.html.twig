{% extends 'ApplicationSonataUserBundle:Profile:action.html.twig' %}

{% block sonata_profile_title %}{{ 'user.topic.list_page.title'|trans }}{% endblock %}

{% block sonata_profile_content %}
    {% block chain_navigation %}{% endblock %}
    <div class="row">
        <div class="col-sm-12">
            <p><a href="{{ path('sonata_user_topic_create') }}" class="btn btn-info">{{ 'user.topic.list_page.create_button'|trans }}</a></p>
            {#<table class="table table-bordered">#}
                {#<thead>#}
                {#<tr>#}
                    {#<th>{{ 'user.topic.list_page.table.name'|trans }}</th>#}
                {#</tr>#}
                {#</thead>#}
                {#<tbody>#}
            <div class="row">
                {% for topic in topics %}
                    {#<tr>#}
                    <div class="col-sm-4 chain-list">
                        {{ topic.name }} ({{ topic.user.firstname }})
                        <div class="pull-right">
                            <a class="text-primary" href="{{ path('sonata_user_topic_edit', { 'topicId': topic.id }) }}">
                                <span class="glyphicon glyphicon-pencil" aria-hidden="true"></span>
                            </a>
                            <a class="chain-remove text-danger" href="{{ path('sonata_user_topic_remove', { 'topicId': topic.id }) }}">
                                <span class="glyphicon glyphicon-remove" aria-hidden="true"></span>
                            </a>
                        </div>
                    </div>

                    {#</tr>#}
                {% endfor %}
            </div>

                {#</tbody>#}
            {#</table>#}
        </div>
    </div>

{% endblock %}