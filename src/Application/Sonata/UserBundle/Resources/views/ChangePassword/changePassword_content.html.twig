{% form_theme form '@ApplicationSonataUser/Profile/Form/form-change-password-content.html.twig' %}

{{ form_start(form, {'action': path('user_change_password'), 'attr': {'class':'form-horizontal'}  }) }}
{{ form_widget(form) }}

<div class="form-actions form-group">
    <div class="col-sm-12">
        <button type="submit" class="btn btn-danger pull-right">{{ 'change_password.submit'|trans({}, 'FOSUserBundle') }}</button>
    </div>
</div>
{{ form_end(form) }}
